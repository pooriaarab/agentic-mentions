{
  "name": "agentic-mentions",
  "version": "0.1.0",
  "description": "Deduplicate and triage inbound brand mentions with rule-based sentiment, urgency queues, a Node.js SDK, CLI, and MCP server.",
  "keywords": [
    "brand-mentions",
    "comment-triage",
    "sentiment-analysis",
    "deduplication",
    "urgency-queue",
    "webhooks",
    "nodejs",
    "typescript",
    "cli",
    "mcp",
    "model-context-protocol",
    "zod"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooriaarab/agentic-mentions.git"
  },
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-mentions",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-mentions": "./dist/cli.js",
    "agentic-mentions-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
